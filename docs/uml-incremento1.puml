@startuml uml-incremento1
title Sistema de Gestion de Tutorias -- Incremento 1 (Ae3)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "domain" {
  abstract class Usuario {
    -id: String
    -nombre: String
    -correo: String
  }
  class Estudiante extends Usuario {
    -carrera: String
  }
  class Docente extends Usuario {
    -especialidad: String
    -horariosPublicados: List<HorarioDisponible>
    +publicarHorario(...): HorarioDisponible
  }
  class HorarioDisponible {
    -fecha: LocalDate
    -horaInicio: LocalTime
    -horaFin: LocalTime
    -disponible: boolean
    +reservar()
    +liberar()
  }
  enum EstadoReserva {
    PENDIENTE
    CONFIRMADA
    CANCELADA
    REPROGRAMADA
    FINALIZADA
  }
  enum Modalidad {
    PRESENCIAL
    VIRTUAL
  }
  enum CanalNotificacion {
    EMAIL
    SMS
    PUSH
    WHATSAPP
  }
  enum TipoReserva {
    NORMAL
    PRIORITARIA
    GRUPAL
  }

  class Reserva {
    -id: String
    -estado: EstadoReserva
    -modalidad: Modalidad
    -canalNotificacionPreferido: CanalNotificacion
    -tipo: TipoReserva
    -observadores: List<ReservaObserver>
    ~Reserva(builder: ReservaBuilder)
    +confirmar()
    +cancelar()
    +reprogramar(nuevoHorario)
    +finalizar()
    +agregarObservador(o: ReservaObserver)
  }
  note right of Reserva
    Product del Builder (constructor de
    paquete) y Subject del Observer:
    notifica a sus observadores despues
    de cada transicion valida.
  end note

  class ReservaBuilder {
    +estudiante(e): ReservaBuilder
    +docente(d): ReservaBuilder
    +horario(h): ReservaBuilder
    +modalidad(m): ReservaBuilder
    +tipo(t): ReservaBuilder
    +canalNotificacionPreferido(c): ReservaBuilder
    +observador(o): ReservaBuilder
    +build(): Reserva
  }
  note bottom of ReservaBuilder
    Builder: campos obligatorios
    (estudiante, docente, horario) y
    opcionales con valor por defecto.
  end note

  interface ReservaObserver {
    +onCambioEstado(reserva, anterior, nuevo)
  }

  Docente "1" o-- "*" HorarioDisponible : publica >
  Reserva "*" --> "1" Estudiante
  Reserva "*" --> "1" Docente
  Reserva "1" --> "1" HorarioDisponible
  Reserva "1" --> "1" EstadoReserva
  Reserva "*" --> "0..1" TipoReserva
  ReservaBuilder ..> Reserva : construye >
  Reserva "1" o-- "*" ReservaObserver : notifica >
}

package "notification" {
  interface Notificador {
    +notificar(destinatario: Usuario, mensaje: String)
  }
  class NotificadorCorreo implements Notificador
  class NotificadorSMS implements Notificador
  class NotificadorPush implements Notificador
  class NotificadorWhatsApp implements Notificador

  package "notification.factory" {
    abstract class NotificadorFactory {
      +{abstract} crearNotificador(): Notificador
      +enviar(destinatario, mensaje)
    }
    class NotificadorCorreoFactory extends NotificadorFactory
    class NotificadorSMSFactory extends NotificadorFactory
    class NotificadorPushFactory extends NotificadorFactory
    class NotificadorWhatsAppFactory extends NotificadorFactory
    class NotificadorFactoryProvider {
      +{static} factoryPara(canal: CanalNotificacion): NotificadorFactory
    }
  }
  NotificadorCorreoFactory ..> NotificadorCorreo : crea >
  NotificadorSMSFactory ..> NotificadorSMS : crea >
  NotificadorPushFactory ..> NotificadorPush : crea >
  NotificadorWhatsAppFactory ..> NotificadorWhatsApp : crea >
  NotificadorFactoryProvider ..> NotificadorFactory
}

package "observer" {
  class ObservadorNotificaciones implements domain.ReservaObserver
  class ObservadorCalendario implements domain.ReservaObserver
  class ObservadorPanelAdministrativo implements domain.ReservaObserver {
    -bitacora: List<String>
    +getBitacora(): List<String>
  }
  ObservadorNotificaciones ..> NotificadorFactoryProvider : usa >
}

package "cancelacion" {
  interface PoliticaCancelacion {
    +validar(reserva: Reserva)
  }
  class CancelacionNormalPolitica implements PoliticaCancelacion
  class CancelacionPrioritariaPolitica implements PoliticaCancelacion
  class CancelacionGrupalPolitica implements PoliticaCancelacion
  class PoliticaCancelacionProvider {
    +{static} politicaPara(tipo: TipoReserva): PoliticaCancelacion
  }
  class CancelacionNoPermitidaException
  PoliticaCancelacionProvider ..> PoliticaCancelacion
  PoliticaCancelacion ..> CancelacionNoPermitidaException : lanza >
}

package "repository" {
  interface ReservaRepository {
    +guardar(reserva: Reserva)
    +buscarPorId(id: String): Optional<Reserva>
    +listarTodas(): List<Reserva>
  }
  class ReservaRepositoryMemoria implements ReservaRepository
}

package "service" {
  class ServicioReservas {
    -repository: ReservaRepository
    -observadoresPorDefecto: List<ReservaObserver>
    +crearReserva(builder: ReservaBuilder): Reserva
    +confirmarReserva(id): Reserva
    +cancelarReserva(id): Reserva
    +reprogramarReserva(id, nuevoHorario): Reserva
    +finalizarReserva(id): Reserva
  }
  note right of ServicioReservas
    DIP: depende de ReservaRepository y
    de la lista de ReservaObserver, no
    de implementaciones concretas.
  end note
}

ServicioReservas --> ReservaRepository
ServicioReservas ..> domain.ReservaBuilder : arma >
ServicioReservas ..> PoliticaCancelacionProvider : valida cancelacion >
ServicioReservas o-- "*" domain.ReservaObserver : observadores por defecto

@enduml
